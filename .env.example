# ---------------------------------------------------------------------------
# Dashboard (/dashboard) — copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------------------

# Personal Access Token from https://api.up.com.au/getting_started
# Read-only access to your Up accounts and transactions. Starts with "up:yeah:".
UP_API_TOKEN=

# The password you type at /login.
DASHBOARD_PASSWORD=@

# Signs the session cookie. Generate with: openssl rand -base64 32
# Changing this invalidates every existing session.
SESSION_SECRET=

# Your weekly take-home pay after tax, in dollars, e.g. 2481.32
# Up can't work this out for itself — some deposits arrive gross and some net.
# State it as a MINIMUM: every figure built on it is then a floor, so a better
# week only ever leaves more over. Leave blank and the "Where your pay should
# go" panel simply doesn't render.
WEEKLY_TAKE_HOME=
